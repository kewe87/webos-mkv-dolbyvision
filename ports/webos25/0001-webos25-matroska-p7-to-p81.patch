+        return TRUE;
+      }
+      matroska_dv_log ("decision profile=7.%d: profile 7 is played as HDR10",
+          demux->dv_bl_signal_comp_id);
+#endif
       GST_DEBUG_OBJECT (demux,
           "Dolby Vision profile 7 is not supported, but can play as HDR10.");
       return TRUE;
