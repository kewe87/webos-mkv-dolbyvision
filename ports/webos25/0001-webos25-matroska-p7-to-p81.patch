+#ifdef DOLBYHDR_SUPPORT
+#define MATROSKA_DV_LOG "/tmp/matroska-dv.log"
+
+static void
+matroska_dv_log (const gchar * format, ...)
+    G_GNUC_PRINTF (1, 2);
+
+static void
+matroska_dv_log (const gchar * format, ...)
+{
+  FILE *f;
+  va_list args;
+
+  f = fopen (MATROSKA_DV_LOG, "a");
+  if (f == NULL)
+    return;
+
+  va_start (args, format);
+  vfprintf (f, format, args);
+  va_end (args);
+  fputc ('\n', f);
+  fclose (f);
+}
